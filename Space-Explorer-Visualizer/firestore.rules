rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Algorithm simulation benchmarks and execution telemetry
    match /simulations/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['algorithm', 'comparisons', 'timestamp'])
                    && request.resource.data.comparisons is int;
      allow update, delete: if false;
    }

    // Default deny for sensitive paths, public read for static datasets
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}